# ================================================
# AI Resume Screening System - Environment Config
# ================================================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control

# Server Port
PORT=5000

# Node Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection URI
# Local: mongodb://127.0.0.1:27017/ai_resume_screening
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ai_resume_screening?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ai_resume_screening

# JWT Secret Key (generate a strong random string for production)
JWT_SECRET=change_this_to_a_strong_random_secret_key

# Google Gemini API Key (required for AI resume analysis)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# RapidAPI Key (optional - for LinkedIn profile scraping)
RAPIDAPI_KEY=your_rapidapi_key_here

# GitHub Token (optional - for GitHub profile lookup, increases rate limits)
GITHUB_TOKEN=your_github_token_here

# Email SMTP Config (optional - for contact form email delivery)
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_specific_password
