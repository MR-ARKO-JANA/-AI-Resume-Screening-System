# ── .dockerignore ─────────────────────────────────────────────
# Files excluded from Docker build context (keeps image lean)

# Dependencies (installed fresh in container)
node_modules/
npm-debug.log*
yarn-debug.log*

# Environment / secrets (NEVER bake into image)
.env
.env.*
!.env.example

# Git metadata
.git/
.gitignore

# IDE / OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test / dev files
*.test.js
*.spec.js
__tests__/
coverage/

# Build artifacts
dist/
build/
.next/
out/

# Uploaded files (runtime data, not source)
backend/uploads/

# Large binary/media files not needed in image
*.pdf
*.png
*.jpg
*.jpeg
*.webp
dashboard.png
project_report.md
README.md

# Stray directories
backend/backend/
frontend-react/

# Docker files themselves
Dockerfile*
.dockerignore
docker-compose*.yml
