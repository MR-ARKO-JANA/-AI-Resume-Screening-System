# ================================================
# AI Resume Screening System - Environment Config
# ================================================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control

# Server Port
PORT=5000

# Node Environment (development | production | test)
NODE_ENV=development

# Neon PostgreSQL Database Connection URI (Get free DB at https://neon.tech)
# Example: postgresql://neondb_owner:password@ep-xyz-123.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_KjLlc6o2zVdm@ep-round-glitter-b5kyb28b-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# JWT Secret Key (generate a strong random string for production)
JWT_SECRET=change_this_to_a_strong_random_secret_key

# Google Gemini API Key (required for AI resume analysis & auto-sync)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# RapidAPI Key (optional - for LinkedIn profile scraping)
# Get your key at: https://rapidapi.com
RAPIDAPI_KEY=your_rapidapi_key_here

# GitHub Token (optional - for GitHub profile lookup, increases rate limits)
# Get your token at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# Email SMTP Config (optional - for contact form email delivery)
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_specific_password
